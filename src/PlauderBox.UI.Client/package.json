{
  "name": "plauderbox-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"../PlauderBox.Logik/Client/**/*.ts\" \"*.{js,json}\"",
    "lint": "eslint --config eslint.config.js \"src/**/*.{ts,vue}\"",
    "test": "vitest run",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@11.25.0"
}
